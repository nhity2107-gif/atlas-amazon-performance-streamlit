# Copy this file to .streamlit/secrets.toml and replace the placeholders.
# Never commit the real secrets.toml file.

LARK_APP_ID = "your_app_id"
LARK_APP_SECRET = "your_app_secret"
LARK_BASE_TOKEN = "your_base_token"
LARK_TOTAL_ASIN_TABLE_ID = "your_total_asin_table_id"
LARK_MRND_IDEA_TABLE_ID = "your_mrnd_idea_table_id"
LARK_CLIPARTS_TABLE_ID = "your_cliparts_table_id"

# Fernet key used to decrypt the public-repository Ads snapshot.
# Generate locally with: python scripts/setup_publish_key.py
PUBLISHED_SNAPSHOT_KEY = "your_fernet_key"
